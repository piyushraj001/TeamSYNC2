// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ============ USERS ============
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  displayName  String
  avatarUrl    String?
  authProvider AuthProvider @default(EMAIL)
  resetToken    String?   @unique
  resetTokenExpiry DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  workspaceMemberships   WorkspaceMember[]
  channelMemberships     ChannelMember[]
  messages               Message[]
  sentDirectMessages     DirectMessage[]   @relation("SentDMs")
  receivedDirectMessages DirectMessage[]   @relation("ReceivedDMs")
  ownedWorkspaces        Workspace[]       @relation("WorkspaceOwner")
  createdChannels        Channel[]         @relation("ChannelCreator")
  sessions               Session[]
  createdInvites         Invite[]  @relation("InviteCreator")
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

// ============ SESSIONS ============
model Session {
  id               String   @id @default(uuid())
  refreshTokenHash String   @unique
  deviceInfo       String?  // e.g. "Chrome on macOS"
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  expiresAt        DateTime

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// ============ INVITES ============
enum InviteType {
  LINK
  EMAIL
}

model Invite {
  id          String     @id @default(uuid())
  token       String     @unique @default(uuid())
  type        InviteType @default(LINK)
  email       String?                        // Only for email-type invites
  maxUses     Int?                            // null = unlimited
  useCount    Int        @default(0)
  expiresAt   DateTime?                       // null = never expires
  revokedAt   DateTime?                       // null = active
  createdAt   DateTime   @default(now())

  // Relations
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  createdBy   User       @relation("InviteCreator", fields: [createdById], references: [id])
  createdById String

  @@index([workspaceId])
}

// ============ WORKSPACES ============
model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  inviteCode  String   @unique @default(uuid())
  imageUrl    String?
  createdAt   DateTime @default(now())

  // Relations
  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  ownerId  String
  members  WorkspaceMember[]
  channels Channel[]
  invites  Invite[]
}

model WorkspaceMember {
  id       String        @id @default(uuid())
  role     WorkspaceRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

// ============ CHANNELS ============
model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  createdBy   User?           @relation("ChannelCreator", fields: [createdById], references: [id])
  createdById String?
  members     ChannelMember[]
  messages    Message[]

  @@unique([name, workspaceId])
}

model ChannelMember {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now())

  // Relations
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  @@unique([userId, channelId])
}

// ============ MESSAGES ============
model Message {
  id        String    @id @default(uuid())
  content   String
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  sender    User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
}

model DirectMessage {
  id             String   @id @default(uuid())
  content        String
  conversationId String
  createdAt      DateTime @default(now())

  // Relations
  sender     User   @relation("SentDMs", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String
  receiver   User   @relation("ReceivedDMs", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  @@index([conversationId])
}
